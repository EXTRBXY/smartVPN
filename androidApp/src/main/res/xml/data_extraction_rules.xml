<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup and device-to-device transfer: exclude all app data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
